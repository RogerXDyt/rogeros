#!/usr/bin/env python3
"""Centro RogerOS: bienvenida, panel de control, rendimiento y tienda de apps."""
import os, shutil, subprocess, sys, platform
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, GdkPixbuf

LOGO = "/usr/share/rogeros/logo.png"
MODO = "/etc/rogeros/modo"
PRIMERA = os.path.expanduser("~/.config/rogeros/bienvenida-vista")

CSS = b"""
window, .fondo { background-color: #0a0218; color: #e0f7ff; }
.lateral { background-color: #12042a; border-right: 1px solid #00e5ff; }
.lateral row { padding: 12px 18px; font-size: 13pt; }
.lateral row:selected { background-color: rgba(255,43,214,0.25); box-shadow: inset 4px 0 #ff2bd6; }
.titulo { font-size: 26pt; font-weight: 800; color: #00e5ff; }
.sub { color: #b98ce0; font-size: 11pt; }
.tarjeta { background-color: #150533; border: 1px solid rgba(0,229,255,0.35); border-radius: 12px; padding: 16px; }
.tarjeta:hover { border-color: #ff2bd6; }
.neon { background-image: none; background-color: transparent; color: #00e5ff; border: 2px solid #00e5ff;
        border-radius: 10px; padding: 8px 18px; font-weight: bold; }
.neon:hover { background-color: rgba(0,229,255,0.18); box-shadow: 0 0 12px #00e5ff; }
.rosa { color: #ff2bd6; border-color: #ff2bd6; }
.rosa:hover { background-color: rgba(255,43,214,0.18); box-shadow: 0 0 12px #ff2bd6; }
.activo { background-color: rgba(255,43,214,0.35); }
.dato { font-family: monospace; font-size: 11pt; }
levelbar block.filled { background-color: #00e5ff; }
levelbar block.high { background-color: #ff2bd6; }
"""

try:
    ACENTO = open(os.path.expanduser("~/.config/rogeros/acento")).read().strip() or "#00e5ff"
except OSError:
    ACENTO = "#00e5ff"
_r, _g, _b = (int(ACENTO[i:i + 2], 16) for i in (1, 3, 5))
CSS = CSS.replace(b"#00e5ff", ACENTO.encode()).replace(b"0,229,255", f"{_r},{_g},{_b}".encode())


def terminal(cmd, titulo="RogerOS"):
    """Lanza un comando en una terminal visible para que se vea el progreso."""
    full = f'{cmd}; echo; read -p "Pulsa Enter para cerrar..." _'
    subprocess.Popen(["xfce4-terminal", "--title", titulo, "-x", "bash", "-c", full])


def leer(path, defecto=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return defecto


class Centro(Gtk.Window):
    def __init__(self, pagina="bienvenida"):
        super().__init__(title="Centro RogerOS")
        self.set_default_size(1000, 640)
        if os.path.exists(LOGO):
            self.set_icon_from_file(LOGO)
        prov = Gtk.CssProvider(); prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, 800)

        caja = Gtk.Box()
        self.add(caja)
        self.pila = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_UP_DOWN, transition_duration=250)
        lista = Gtk.ListBox(); lista.get_style_context().add_class("lateral")
        lista.set_size_request(220, -1)
        caja.pack_start(lista, False, False, 0)
        caja.pack_start(self.pila, True, True, 0)

        self.paginas = [
            ("bienvenida", "🏠  Inicio", self.p_bienvenida),
            ("sistema", "📊  Sistema", self.p_sistema),
            ("rendimiento", "⚡  Rendimiento", self.p_rendimiento),
            ("tienda", "🛒  Tienda", self.p_tienda),
            ("mantenimiento", "🧹  Mantenimiento", self.p_mantenimiento),
            ("apariencia", "🎨  Apariencia", self.p_apariencia),
        ]
        for nombre, etiqueta, fn in self.paginas:
            fila = Gtk.ListBoxRow(); fila.nombre = nombre
            l = Gtk.Label(label=etiqueta, xalign=0); fila.add(l); lista.add(fila)
            sc = Gtk.ScrolledWindow(); sc.get_style_context().add_class("fondo")
            sc.add(fn()); self.pila.add_named(sc, nombre)
        lista.connect("row-selected", lambda _l, r: r and self.pila.set_visible_child_name(r.nombre))
        idx = [p[0] for p in self.paginas].index(pagina) if pagina in [p[0] for p in self.paginas] else 0
        self.connect("show", lambda *_: lista.select_row(lista.get_row_at_index(idx)))
        self.connect("destroy", Gtk.main_quit)
        GLib.timeout_add_seconds(1, self.refrescar)

    # ---------- utilidades de interfaz ----------
    def cabecera(self, titulo, sub):
        b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin=28)
        t = Gtk.Label(label=titulo, xalign=0); t.get_style_context().add_class("titulo")
        s = Gtk.Label(label=sub, xalign=0); s.get_style_context().add_class("sub")
        b.pack_start(t, False, False, 0); b.pack_start(s, False, False, 0)
        return b

    def boton(self, texto, fn, rosa=False):
        b = Gtk.Button(label=texto); b.get_style_context().add_class("neon")
        if rosa: b.get_style_context().add_class("rosa")
        b.connect("clicked", lambda *_: fn()); return b

    def tarjeta(self, titulo, texto, *botones):
        t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8); t.get_style_context().add_class("tarjeta")
        a = Gtk.Label(xalign=0); a.set_markup(f"<b><span size='large' color='#00e5ff'>{titulo}</span></b>")
        d = Gtk.Label(label=texto, xalign=0, wrap=True); d.get_style_context().add_class("sub")
        t.pack_start(a, False, False, 0); t.pack_start(d, True, True, 0)
        fila = Gtk.Box(spacing=8)
        for b in botones: fila.pack_start(b, False, False, 0)
        t.pack_end(fila, False, False, 0)
        return t

    def rejilla(self, hijos, cols=2):
        g = Gtk.Grid(column_spacing=14, row_spacing=14, margin_start=28, margin_end=28, margin_bottom=28,
                     column_homogeneous=True)
        for i, h in enumerate(hijos): g.attach(h, i % cols, i // cols, 1, 1)
        return g

    def pagina(self, titulo, sub, *hijos):
        b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        b.pack_start(self.cabecera(titulo, sub), False, False, 0)
        for h in hijos: b.pack_start(h, False, False, 0)
        return b

    # ---------- páginas ----------
    def p_bienvenida(self):
        b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=28)
        if os.path.exists(LOGO):
            b.pack_start(Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_size(LOGO, 140, 140)), False, False, 10)
        t = Gtk.Label(); t.set_markup("<span size='30000' weight='heavy' color='#00e5ff'>Bienvenido a ROGER<span color='#ff2bd6'>OS</span></span>")
        b.pack_start(t, False, False, 0)
        s = Gtk.Label(label="Tu sistema está listo. Aquí tienes lo primero que puedes hacer:")
        s.get_style_context().add_class("sub"); b.pack_start(s, False, False, 6)
        # En el modo en vivo se ofrece instalar; ya instalado, se ofrece la copia de seguridad
        if os.path.isdir("/run/live"):
            primera = self.tarjeta("Instalar en el disco", "Pon RogerOS en tu ordenador de forma permanente.",
                                   self.boton("Instalar", lambda: subprocess.Popen(["rogeros-instalar"]), True))
        else:
            primera = self.tarjeta("Copia de seguridad", "Guarda tu carpeta personal comprimida en ~/Copias.",
                                   self.boton("Hacer copia", lambda: terminal("roger copia ~"), True))
        b.pack_start(self.rejilla([
            primera,
            self.tarjeta("Preparar para jugar", "Steam, Wine, Vulkan y librerías de 32 bits en un clic.",
                         self.boton("Preparar", lambda: terminal("roger steam"))),
            self.tarjeta("Tienda de apps", "OBS, Discord, Blender, Minecraft y más.",
                         self.boton("Abrir tienda", lambda: subprocess.Popen(["rogertienda"]))),
            self.tarjeta("Actualizar", "Descarga las últimas mejoras y parches de seguridad.",
                         self.boton("Actualizar", lambda: subprocess.Popen(["rogeros-actualizar"]))),
        ]), False, False, 0)
        chk = Gtk.CheckButton(label="Mostrar al iniciar sesión")
        chk.set_active(not os.path.exists(PRIMERA))
        chk.connect("toggled", self.cambiar_inicio)
        b.pack_start(chk, False, False, 0)
        return b

    def cambiar_inicio(self, chk):
        os.makedirs(os.path.dirname(PRIMERA), exist_ok=True)
        if chk.get_active():
            if os.path.exists(PRIMERA): os.remove(PRIMERA)
        else:
            open(PRIMERA, "w").close()

    def p_sistema(self):
        cpu = next((l.split(":", 1)[1].strip() for l in leer("/proc/cpuinfo").splitlines() if l.startswith("model name")), "?")
        gpu = subprocess.run("lspci | grep -iE 'vga|3d' | cut -d: -f3", shell=True, capture_output=True, text=True).stdout.strip() or "?"
        info = Gtk.Label(xalign=0, selectable=True); info.get_style_context().add_class("dato")
        info.set_markup(
            f"<span color='#ff2bd6'>Sistema</span>   RogerOS Linux 1.0 (Neón)\n"
            f"<span color='#ff2bd6'>Kernel</span>    {platform.release()}\n"
            f"<span color='#ff2bd6'>CPU</span>       {GLib.markup_escape_text(cpu)} ({os.cpu_count()} hilos)\n"
            f"<span color='#ff2bd6'>Gráfica</span>   {GLib.markup_escape_text(gpu)}\n"
            f"<span color='#ff2bd6'>Usuario</span>   {os.environ.get('USER', '?')}")
        t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); t.get_style_context().add_class("tarjeta")
        t.pack_start(info, False, False, 0)
        self.barras = {}
        for k in ("CPU", "RAM", "Disco"):
            fila = Gtk.Box(spacing=10)
            l = Gtk.Label(label=k, xalign=0); l.set_size_request(60, -1)
            bar = Gtk.LevelBar(min_value=0, max_value=1); bar.set_hexpand(True)
            bar.add_offset_value("high", 0.85)
            val = Gtk.Label(label="…"); val.set_size_request(160, -1); val.get_style_context().add_class("dato")
            fila.pack_start(l, False, False, 0); fila.pack_start(bar, True, True, 0); fila.pack_start(val, False, False, 0)
            t.pack_start(fila, False, False, 0); self.barras[k] = (bar, val)
        cont = Gtk.Box(margin_start=28, margin_end=28); cont.pack_start(t, True, True, 0)
        self._cpu_prev = None
        return self.pagina("Sistema", "Lo que hay dentro de tu máquina, en directo", cont)

    def refrescar(self):
        if not hasattr(self, "barras"): return True
        campos = [int(x) for x in leer("/proc/stat").splitlines()[0].split()[1:]]
        total, idle = sum(campos), campos[3] + campos[4]
        if self._cpu_prev:
            dt, di = total - self._cpu_prev[0], idle - self._cpu_prev[1]
            uso = 1 - di / dt if dt else 0
            self.barras["CPU"][0].set_value(uso); self.barras["CPU"][1].set_text(f"{uso*100:.0f} %")
        self._cpu_prev = (total, idle)
        mem = {l.split(":")[0]: int(l.split()[1]) for l in leer("/proc/meminfo").splitlines()}
        usada = mem["MemTotal"] - mem["MemAvailable"]
        self.barras["RAM"][0].set_value(usada / mem["MemTotal"])
        self.barras["RAM"][1].set_text(f"{usada/1048576:.1f} / {mem['MemTotal']/1048576:.1f} GB")
        d = shutil.disk_usage("/")
        self.barras["Disco"][0].set_value(d.used / d.total)
        self.barras["Disco"][1].set_text(f"{d.used/1e9:.0f} / {d.total/1e9:.0f} GB")
        return True

    def p_rendimiento(self):
        actual = leer(MODO, "normal")
        modos = [("juego", "🎮 Modo Juego", "CPU siempre a máxima frecuencia y menos intercambio a disco. Para jugar y renderizar."),
                 ("normal", "⚖️ Modo Normal", "Equilibrio entre potencia y consumo. El de siempre."),
                 ("ahorro", "🔋 Modo Ahorro", "Menos consumo y menos ruido. Ideal para portátiles.")]
        self.btn_modo = {}
        tarjetas = []
        for m, t, d in modos:
            b = self.boton("Activo" if m == actual else "Activar", lambda m=m: self.poner_modo(m), m == "juego")
            if m == actual: b.get_style_context().add_class("activo")
            self.btn_modo[m] = b
            tarjetas.append(self.tarjeta(t, d, b))
        return self.pagina("Rendimiento", "Elige cómo quieres que se comporte tu PC", self.rejilla(tarjetas, 3))

    def poner_modo(self, m):
        if subprocess.run(["sudo", "-n", "roger", "modo", m]).returncode != 0:
            subprocess.run(["pkexec", "roger", "modo", m])
        actual = leer(MODO, "normal")
        for k, b in self.btn_modo.items():
            b.set_label("Activo" if k == actual else "Activar")
            (b.get_style_context().add_class if k == actual else b.get_style_context().remove_class)("activo")

    def p_tienda(self):
        abrir = lambda: subprocess.Popen(["rogertienda"])
        return self.pagina("Tienda", "Miles de apps y juegos de Flathub, con un clic y sin contraseña", self.rejilla([
            self.tarjeta("Abrir la Tienda RogerOS", "Juegos, Discord, OBS, Spotify, Blender, Minecraft, VS Code… "
                         "Más de 3.000 apps con buscador y categorías.", self.boton("Abrir tienda", abrir, True)),
            self.tarjeta("Mis apps", "Mira, abre o desinstala lo que ya tienes.", self.boton("Ver mis apps", abrir)),
        ]))

    def p_mantenimiento(self):
        return self.pagina("Mantenimiento", "Deja tu sistema limpio y seguro", self.rejilla([
            self.tarjeta("Actualizar todo", "Sistema, apps y versiones nuevas de RogerOS.", self.boton("Actualizar", lambda: subprocess.Popen(["rogeros-actualizar"]))),
            self.tarjeta("Limpiar", "Borra cachés, paquetes que sobran y registros viejos.", self.boton("Limpiar", lambda: terminal("roger limpiar"), True)),
            self.tarjeta("Copia de seguridad", "Guarda tu carpeta personal comprimida en ~/Copias.", self.boton("Hacer copia", lambda: terminal("roger copia ~"))),
            self.tarjeta("Driver NVIDIA", "Si tienes gráfica NVIDIA, instala su driver oficial.", self.boton("Instalar driver", lambda: terminal("roger nvidia"))),
            self.tarjeta("Cortafuegos", "Bloquea conexiones entrantes no deseadas (ya activo).", self.boton("Ver estado", lambda: terminal("sudo ufw status verbose"))),
            self.tarjeta("Monitor de procesos", "Mira qué está usando tu CPU y RAM.", self.boton("Abrir", lambda: terminal("htop"))),
        ]))

    def p_apariencia(self):
        acentos = [("Cian neón", "#00e5ff"), ("Rosa neón", "#ff2bd6"), ("Verde ácido", "#39ff14"),
                   ("Oro", "#ffc400"), ("Violeta", "#a259ff"), ("Rojo láser", "#ff3b3b"),
                   ("Naranja", "#ff8c1a"), ("Azul hielo", "#4dabff")]
        fila = Gtk.FlowBox(margin_start=28, margin_end=28, selection_mode=Gtk.SelectionMode.NONE,
                           max_children_per_line=4, column_spacing=10, row_spacing=10)
        for n, c in acentos:
            b = Gtk.Button(); b.get_style_context().add_class("neon")
            marca = "  ✔" if c.lower() == ACENTO.lower() else ""
            l = Gtk.Label(); l.set_markup(f"<span color='{c}' size='x-large'>●</span>  {n}{marca}"); b.add(l)
            b.connect("clicked", lambda _b, c=c: self.poner_acento(c)); fila.add(b)

        # Fondo: vista previa del actual + un botón que abre el selector del pack
        pack = "/usr/share/backgrounds/rogeros/pack"
        elegido = leer(os.path.expanduser("~/.config/rogeros/fondo"), "lago")
        prev = os.path.join(pack, "mini", elegido + ".jpg")
        if not os.path.exists(prev):
            prev = elegido if os.path.isfile(elegido) else os.path.join(pack, "mini", "lago.jpg")
        t = Gtk.Box(spacing=18); t.get_style_context().add_class("tarjeta")
        if os.path.exists(prev):
            t.pack_start(Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(prev, 320, 180, True)), False, False, 0)
        d = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        n = Gtk.Label(xalign=0); n.set_markup(f"<b><span size='large' color='{ACENTO}'>Fondo de pantalla</span></b>")
        s = Gtk.Label(label="Más de diez paisajes hechos con IA, el neón clásico o una foto tuya.", xalign=0, wrap=True)
        s.get_style_context().add_class("sub")
        d.pack_start(n, False, False, 0); d.pack_start(s, False, False, 0)
        d.pack_start(self.boton("Cambiar fondo", lambda: subprocess.Popen(["rogeros-fondos"]), True), False, False, 6)
        t.pack_start(d, True, True, 0)
        caja_fondo = Gtk.Box(margin=28); caja_fondo.pack_start(t, True, True, 0)
        return self.pagina("Apariencia", "Color de acento: cambia botones, selecciones, barra de tareas, terminal y apps de RogerOS",
                           fila, caja_fondo)

    def poner_acento(self, color):
        subprocess.run(["rogeros-acento", color])
        # Reabrir el Centro para que también él se pinte con el color nuevo
        os.execv(sys.executable, [sys.executable, os.path.abspath(sys.argv[0]), "apariencia"])


if __name__ == "__main__":
    pag = "bienvenida"
    if "--bienvenida" in sys.argv:
        if os.path.exists(PRIMERA): sys.exit(0)
    elif len(sys.argv) > 1:
        pag = sys.argv[1]
    Centro(pag).show_all()
    Gtk.main()
